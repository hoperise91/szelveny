---
import "../styles/global.css";
import { routes, strings, type Lang, type Page } from "../lib/i18n";

interface Props {
  lang: Lang;
  page: Page;
  title?: string;
  description?: string;
  fullscreen?: boolean;
  /** Paths of this page in each language that has it (hreflang). Default: the page's routes. */
  alternates?: Partial<Record<Lang, string>>;
  /** Where the language button goes, when it differs from the other language's alternate. */
  switchHref?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
}
const {
  lang, page, title, description, fullscreen = false,
  alternates = { hu: routes.hu[page], en: routes.en[page] },
  switchHref, ogImage: ogImagePath = "/og-image.png", noindex = false, jsonLd = [],
} = Astro.props;
const s = strings[lang];
const r = routes[lang];
const other: Lang = lang === "hu" ? "en" : "hu";
const pageTitle = title ? `${title} · Szelvény` : `Szelvény · ${s.tagline}`;
const pageDescription = description ?? s.tagline;
// Link previews (iMessage, WhatsApp, Facebook, LinkedIn…) need absolute URLs and a PNG image.
const abs = (p: string) => new URL(p, Astro.site).href;
const pageUrl = abs(Astro.url.pathname);
const ogImage = abs(ogImagePath);
const otherHref = switchHref ?? alternates[other] ?? routes[other][page];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : <link rel="canonical" href={pageUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Szelvény" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Szelvény · ${s.tagline}`} />
    <meta property="og:locale" content={lang === "hu" ? "hu_HU" : "en_GB"} />
    {alternates[other] && <meta property="og:locale:alternate" content={other === "hu" ? "hu_HU" : "en_GB"} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    {!noindex && alternates.hu && alternates.en && (
      <>
        <link rel="alternate" hreflang="hu" href={abs(alternates.hu)} />
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        <link rel="alternate" hreflang="x-default" href={abs(alternates.hu)} />
      </>
    )}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={fullscreen ? "fullscreen" : ""}>
    <header class="site-header">
      <a class="brand" href={r.map} aria-label="Szelvény">
        <svg class="brand-mark" viewBox="0 0 22 30" aria-hidden="true">
          <path d="M3 9 Q3 2 11 2 Q19 2 19 9 Z" fill="var(--accent)" />
          <rect x="3" y="9" width="16" height="19" rx="1.5" fill="var(--panel)" stroke="var(--ink)" stroke-width="1.6" />
          <path d="M3 9 Q3 2 11 2 Q19 2 19 9" fill="none" stroke="var(--ink)" stroke-width="1.6" />
          <rect x="6.5" y="14" width="9" height="2" fill="var(--ink)" />
          <rect x="6.5" y="19" width="6" height="2" fill="var(--ink)" />
        </svg>
        <span class="brand-name">Szelvény</span>
        <span class="brand-tag">{s.tagline}</span>
      </a>
      <nav class="site-nav" aria-label="Szelvény">
        <a href={r.map} aria-current={page === "map" ? "page" : undefined}>{s.nav_map}</a>
        <a href={r.data} aria-current={page === "data" ? "page" : undefined}>{s.nav_data}</a>
        <a href={r.about} aria-current={page === "about" ? "page" : undefined}>{s.nav_about}</a>
        <a class="lang" href={otherHref} hreflang={other} lang={other} data-keep-query>{s.other_lang}</a>
      </nav>
    </header>
    <slot />
    <script>
      // Keep the selected road (?r=, ?km=) when switching language. The link's own query
      // (e.g. /en/road/?r=KEY for roads without an English page) wins over the current one.
      document.querySelectorAll<HTMLAnchorElement>("a[data-keep-query]").forEach((a) => {
        const own = new URL(a.href).searchParams;
        a.addEventListener("click", () => {
          const q = new URLSearchParams(location.search);
          own.forEach((v, k) => q.set(k, v));
          const qs = q.toString();
          a.href = a.pathname + (qs ? `?${qs}` : "");
        });
      });
    </script>
  </body>
</html>
