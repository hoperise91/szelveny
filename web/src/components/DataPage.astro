---
import Base from "../layouts/Base.astro";
import { routes, strings, type Lang } from "../lib/i18n";
import { DATA_URL } from "../lib/roads";
import { dataset } from "../lib/seo";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = strings[lang];
const hu = lang === "hu";
// NAP layers come in Phase 3, as separate files from the ODbL (OSM-derived) ones.
const files = [
  ["qa_gaps.csv", hu ? "Az OpenStreetMapben hiányzó vagy hiányos utak" : "Roads missing or incomplete in OpenStreetMap", "ODbL"],
  ["qa_attribute_coverage.csv", hu ? "Jellemzők lefedettsége kategóriánként" : "Attribute coverage per category", "ODbL"],
  ["qa_osm_refs_not_in_network.csv", hu ? "Útszámok az OpenStreetMapben, amelyekhez nincs út a hálózatban" : "OpenStreetMap road numbers with no road in the network", "ODbL"],
];
const dataBase = DATA_URL.startsWith("http") ? DATA_URL : "https://data.szelvenykm.hu";
const ODBL = "https://opendatacommons.org/licenses/odbl/1-0/";
const jsonLd = [
  dataset({
    name: hu ? "Magyarország közúthálózata szelvényekkel (Szelvény)" : "Hungary's road network with chainage (Szelvény)",
    description: hu
      ? "Magyarország közúthálózata (gyorsforgalmi utak, főutak, összekötő és bekötő utak) szelvényekkel, az OpenStreetMapből és a NAP adataiból, minőségellenőrzéssel."
      : "Hungary's road network (motorways, main, connecting and access roads) with chainage, built from OpenStreetMap and NAP data, with quality checks.",
    pagePath: routes[lang].data,
    license: ODBL,
    files: [
      { url: `${dataBase}/szelveny.pmtiles`, format: "application/vnd.pmtiles" },
      ...files.map(([f]) => ({ url: `${dataBase}/downloads/${f}`, format: "text/csv" })),
    ],
  }),
];
---
<Base lang={lang} page="data" title={hu ? "Nyílt adatok: Magyarország közúthálózata" : "Open data: Hungary's road network"} description={s.meta_data} jsonLd={jsonLd}>
  <main class="page">
    <h1>{s.nav_data}</h1>
    <p class="muted">
      {hu
        ? "Minden, amit a Szelvény mutat, letölthető. Minden fájl megtartja a forrása licencét. Tájékoztató jellegű, nem hivatalos forrás."
        : "Everything Szelvény shows can be downloaded. Each file keeps its source's licence. Informational, not an official source."}
    </p>

    <h2>{hu ? "Letöltések" : "Downloads"}</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>{hu ? "Fájl" : "File"}</th><th>{hu ? "Tartalom" : "Contents"}</th><th>{s.licence}</th></tr></thead>
        <tbody>
          {files.map(([f, d, l]) => (
            <tr><td><a class="mono" href={`/data/downloads/${f}`} download data-file>{f}</a></td><td>{d}</td><td class="small">{l}</td></tr>
          ))}
          <tr><td><a class="mono" href="/data/szelveny.pmtiles" download data-file>szelveny.pmtiles</a></td>
            <td>{hu ? "A szelvényezett hálózat vektoros csempékként (PMTiles)" : "The chainage-referenced network as vector tiles (PMTiles)"}</td><td class="small">ODbL</td></tr>
        </tbody>
      </table>
    </div>

    <h2>{hu ? "Frissítések" : "Updates"}</h2>
    <p class="muted">
      {hu
        ? "Az adatokat hetente újraépítjük a forrásokból, és csak akkor tesszük közzé, ha átmennek a minőségellenőrzésen."
        : "The data is rebuilt every week from the sources and published only when it passes the quality checks."}
    </p>
    <ul id="changes" class="changes" data-lang={lang} data-road={routes[lang].road}>
      <li class="muted">{s.loading}</li>
    </ul>

    <h2>{hu ? "Adatok fejlesztőknek" : "Data for developers"}</h2>
    <p>
      {hu
        ? "Minden útnak van egy statikus JSON-fájlja a szelvényezett szakaszokkal (a szelvénykereséshez), a szelvény menti jellemzőkkel és minden érték forrásával:"
        : "Every road has a static JSON file with its chainage-referenced segments (for chainage lookup), its properties along the road and the source of every value:"}
    </p>
    <div class="table-wrap"><table><tbody>
      <tr><td class="mono">{DATA_URL}/index.json</td><td>{hu ? "minden út: kulcs, útszám, megye, kategória, nyomvonal, befoglaló téglalap" : "every road: key, number, county, category, route, bounds"}</td></tr>
      <tr><td class="mono">{DATA_URL}/roads/M1.json</td><td>{hu ? "egy gyorsforgalmi út" : "a motorway"}</td></tr>
      <tr><td class="mono">{DATA_URL}/roads/4512.json</td><td>{hu ? "egy összekötő út (az országos útszámok egyediek)" : "a connecting road (national road numbers are unique)"}</td></tr>
      <tr><td class="mono">{DATA_URL}/changes.json</td><td>{hu ? "mi változott hétről hétre" : "what changed each week"}</td></tr>
      <tr><td class="mono">{DATA_URL}/sources.json</td><td>{hu ? "a források, licenccel és dátummal" : "the sources, with licence and date"}</td></tr>
    </tbody></table></div>
    <p class="small muted">
      {hu
        ? "Szelvény ↔ koordináta: minden szakaszon belül a szelvény a szakasz hossza mentén lineárisan változik."
        : "Chainage ↔ coordinates: within each segment, chainage is linear along the segment's length."}
    </p>
  </main>
</Base>

<script>
  import { DATA_URL } from "../lib/roads";
  document.querySelectorAll<HTMLAnchorElement>("a[data-file]").forEach((a) => {
    a.href = a.getAttribute("href")!.replace(/^\/data/, DATA_URL);
  });

  type Week = {
    date: string; osm?: string; roads: number; baseline?: boolean;
    added?: string[]; removed?: string[]; changed?: number; official?: string[];
    length?: { key: string; from: number; to: number }[];
  };
  const list = document.getElementById("changes")!;
  const hu = list.dataset.lang === "hu";
  const locale = hu ? "hu-HU" : "en-GB";
  const roadUrl = list.dataset.road!;
  const day = (d: string) => new Date(d + "T12:00:00").toLocaleDateString(locale,
    { day: "numeric", month: "long", year: "numeric" });
  const km = (x: number) => x.toLocaleString(locale, { maximumFractionDigits: 1 }) + " km";
  const road = (k: string) => {
    const a = document.createElement("a");
    a.href = `${roadUrl}?r=${encodeURIComponent(k)}`;
    a.textContent = k;
    return a;
  };

  function render(weeks: Week[]) {
    list.replaceChildren();
    if (!weeks.length) {
      list.innerHTML = `<li class="muted">${hu ? "Még nem volt frissítés." : "No updates yet."}</li>`;
      return;
    }
    for (const w of weeks.slice(0, 12)) {
      const li = document.createElement("li");
      const head = document.createElement("div");
      head.innerHTML = `<strong>${day(w.date)}</strong> <span class="small muted">· ` +
        `OpenStreetMap ${hu ? "állapot:" : "from"} ${w.osm ? day(w.osm) : "?"}</span>`;
      li.append(head);
      const items: (string | Node)[][] = [];
      if (w.baseline) items.push([hu ? `Első közzététel: ${w.roads.toLocaleString(locale)} út.`
                                     : `First publication: ${w.roads.toLocaleString(locale)} roads.`]);
      if (w.added?.length) items.push([hu ? "Új utak: " : "New roads: ",
        ...w.added.flatMap((k, i) => (i ? [", ", road(k)] : [road(k)]))]);
      if (w.official?.length) items.push([hu ? "Bekerült a hivatalos hálózatba (hivatalos szelvények): "
                                              : "Now in the official network (official chainage): ",
        ...w.official.flatMap((k, i) => (i ? [", ", road(k)] : [road(k)]))]);
      if (w.removed?.length) items.push([hu ? "Megszűnt utak: " : "Removed roads: ", w.removed.join(", ")]);
      for (const l of w.length ?? []) items.push([road(l.key), `: ${km(l.from)} → ${km(l.to)}`]);
      if (!w.baseline) items.push([w.changed
        ? (hu ? `Összesen ${w.changed} út frissült.` : `${w.changed} roads updated in total.`)
        : (hu ? "Nincs változás." : "No changes.")]);
      const ul = document.createElement("ul");
      for (const parts of items) {
        const item = document.createElement("li");
        item.append(...parts);
        ul.append(item);
      }
      li.append(ul);
      list.append(li);
    }
  }

  fetch(`${DATA_URL}/changes.json`).then((r) => (r.ok ? r.json() : [])).then(render).catch(() => render([]));
</script>

<style>
  .changes { list-style: none; padding: 0; }
  .changes > li { margin: 0 0 1rem; }
  .changes ul { margin: 0.25rem 0 0; padding-left: 1.2rem; }
</style>
