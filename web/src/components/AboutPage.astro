---
import Base from "../layouts/Base.astro";
import { AUTHOR, CONTACT_EMAIL, routes, strings, type Lang } from "../lib/i18n";
import { NAP_CREDIT } from "../lib/seo";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = strings[lang];
const hu = lang === "hu";
---
<Base lang={lang} page="about" title={hu ? "A Szelvényről: források, licencek, módszer" : "About Szelvény: sources, licences and method"} description={s.meta_about}>
  <main class="page about" data-strings={JSON.stringify(s)} id="about">
    <h1>{hu ? "A Szelvényről" : "About Szelvény"}</h1>
    <p class="lead">
      {hu
        ? "A Szelvény Magyarország közútjainak nyílt adatbázisa. Bármely országos közút megkereshető útszám és szelvény szerint („M1 12+300”), a jellemzőivel és minden érték forrásával együtt."
        : "Szelvény is an open database of Hungary's roads. Any national road can be found by its number and chainage (“M1 12+300”), with its properties and the source of every value."}
    </p>
    <p class="disclaimer"><b>{hu
      ? "Tájékoztató jellegű, nem hivatalos forrás."
      : "Informational, not an official source."}</b> {hu
      ? "Az adatok pontosságáért és frissességéért sem a Szelvény, sem az adatszolgáltatók nem vállalnak felelősséget. Hivatalos adatokért forduljon az út kezelőjéhez, vagy használja az "
      : "Neither Szelvény nor the data providers guarantee the data's accuracy or currency. For official data, ask the road's administrator or use "}<a href="https://utszamkereso.kozut.hu/" rel="noopener">Útszámkereső</a>{hu ? " és a " : " and "}<a href="https://kira.gov.hu/" rel="noopener">KIRA</a>{hu ? " oldalát." : "."}</p>

    <h2>{hu ? "Hogyan működik" : "How it works"}</h2>
    <ol class="steps">
      <li><b>{hu ? "A hivatalos hálózat." : "The official network."}</b> {hu
        ? "Az országos közúthálózat útszámai, szelvényei és nyomvonala a Nemzeti Adathozzáférési Pont (NAP) adatcsomagjaiból származnak (Magyar Közút Nonprofit Zrt.)."
        : "Road numbers, chainage and alignment of the national road network come from the data packages of the National Access Point (NAP), published by Magyar Közút Nonprofit Zrt."}</li>
      <li><b>{hu ? "A többi út." : "Other roads."}</b> {hu
        ? "Ami nincs a NAP-ban (önkormányzati és helyi utak), az OpenStreetMapből jön; ezeket név és település azonosítja."
        : "Roads not in NAP (municipal and local roads) come from OpenStreetMap and are identified by name and settlement."}</li>
      <li><b>{hu ? "A szelvény." : "The chainage."}</b> {hu
        ? "A NAP-ban szereplő utaknál a hivatalos szelvény. Az OpenStreetMapből vett utaknál ismert pontokhoz (kilométerkövek, csomópontok) kötjük, és közöttük arányosan osztjuk el."
        : "For roads in NAP, the official chainage. For roads taken from OpenStreetMap, it is pinned at known points (km posts, junctions) and spread proportionally between them."}</li>
      <li><b>{hu ? "A jellemzők." : "The properties."}</b> {hu
        ? "Burkolat, forgalmi sávok, sebességhatár, hidak és forgalom szelvénytartományokra kerülnek, mindegyik a saját forrásával, dátumával és licencével."
        : "Surface, lanes, speed limit, bridges and traffic are placed on chainage ranges, each with its own source, date and licence."}</li>
    </ol>

    <h2>{hu ? "Mennyire pontos" : "How accurate it is"}</h2>
    <div class="quality-cards">
      {(["official", "calibrated", "interpolated", "estimated"] as const).map((q) => (
        <div class="card"><span class="q" data-q={q}><b>{s[`q_${q}`]}</b></span><p class="small muted">{s[`q_${q}_long`]}</p></div>
      ))}
    </div>
    <p id="accuracy" class="muted"></p>

    <h2>{s.sources}</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>{s.source}</th><th>{hu ? "Változat" : "Version"}</th><th>{s.licence}</th></tr></thead>
      <tbody id="sources"><tr><td colspan="3" class="muted">{s.loading}</td></tr></tbody>
    </table></div>
    <p class="small">{NAP_CREDIT}</p>

    <h2>{hu ? "Licencek" : "Licences"}</h2>
    <ul class="steps">
      <li>{hu ? "Programkód: MIT. A Szelvény a " : "Code: MIT. Szelvény is built on the code of "}<a href="https://bornakm.ro" rel="noopener">Bornă</a>{hu ? " (Románia nyílt közúti adatbázisa) kódjára épül." : " (Romania's open road database)."}</li>
      <li>{hu
        ? "NAP-adatok: a NAP felhasználói ÁSZF (2024. március 1.) 32. pontja szerint tárolhatók, továbbadhatók és közzétehetők. A Szelvény nem a NAP vagy a Magyar Közút szolgáltatása, és nem élvezi azok támogatását."
        : "NAP data: may be stored, passed on and published under §32 of NAP's user terms (1 March 2024). Szelvény is not a service of NAP or Magyar Közút and is not endorsed by them."}</li>
      <li>{hu
        ? "Az OpenStreetMapből származtatott rétegek: ODbL (© OpenStreetMap közreműködők), a NAP-rétegektől külön fájlokban."
        : "Layers derived from OpenStreetMap: ODbL (© OpenStreetMap contributors), in separate files from the NAP layers."}</li>
      <li>{hu ? "A többi forrás: az eredeti feltételeik szerint, a fenti táblázatban." : "Other sources: their original terms, listed above."}</li>
    </ul>

    <h2>{hu ? "Kapcsolat" : "Contact"}</h2>
    <p>{hu ? "A Szelvény " : "Szelvény is a personal project by "}{AUTHOR.name[lang]}{hu ? " személyes projektje" : ""}{" "}(<a href={AUTHOR.linkedin} rel="noopener">LinkedIn</a>).</p>
    <p>{hu
      ? "Hibák, hiányzó utak, javítások vagy adateltávolítási kérések: "
      : "Mistakes, missing roads, corrections or requests to take data down: "}<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    <p><a href={routes[lang].map}>← {s.nav_map}</a></p>
  </main>
</Base>

<script>
  import { DATA_URL, fetchSources } from "../lib/roads";
  const root = document.getElementById("about")!;
  const hu = document.documentElement.lang === "hu";
  const esc = (v: unknown) => String(v ?? "").replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  fetchSources().then((rows) => {
    root.querySelector("#sources")!.innerHTML = rows.map((r) =>
      `<tr><td>${r.url ? `<a href="${esc(r.url)}" rel="noopener">${esc(r.name)}</a>` : esc(r.name)}
        ${r.attribution ? `<div class="small muted">${esc(r.attribution)}</div>` : ""}</td>
        <td class="mono small">${esc(r.version)}</td><td class="small">${esc(r.licence)}</td></tr>`).join("");
  });
  fetch(`${DATA_URL}/accuracy.json`).then((r) => r.ok ? r.json() : null).then((a) => {
    if (!a) return;
    root.querySelector("#accuracy")!.textContent = hu
      ? `Teszt (OpenStreetMapből vett utak): ${a.located} kilométerkövet kihagytunk a kalibrálásból, majd a szelvényük alapján kerestük meg. Medián eltérés ${Math.round(a.median_m)} m; ${Math.round(a.within_50m_share * 100)}% 50 m-en belül; 95% ${Math.round(a.p95_m)} m-en belül.`
      : `Test (roads taken from OpenStreetMap): ${a.located} km posts were left out of calibration and then looked up by their chainage. Median error ${Math.round(a.median_m)} m; ${Math.round(a.within_50m_share * 100)}% within 50 m; 95% within ${Math.round(a.p95_m)} m.`;
  });
</script>

<style>
  .lead { font-size: 18px; color: var(--ink-2); }
  .disclaimer { border-left: 3px solid var(--accent); padding: 4px 0 4px 12px; max-width: 72ch; }
  .steps { padding-left: 20px; max-width: 72ch; }
  .steps li { margin-bottom: 10px; }
  .quality-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 12px; }
  .quality-cards p { margin: 6px 0 0; }
  @media (max-width: 700px) { .quality-cards { grid-template-columns: 1fr 1fr; } }
</style>
