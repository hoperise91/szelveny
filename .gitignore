# Data — never committed (large, regenerable). Only .gitkeep placeholders are tracked.
data/**
!data/**/
!data/**/.gitkeep
# Source manifests (licence, terms, attribution, retrieval date) are tracked
!data/raw/*/manifest.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Node / Astro
node_modules/
web/dist/
web/.astro/

# Env & OS
.env
.DS_Store

# Private QA points (e.g. read from Google Street View): never publish
tests/local_checkpoints.csv
*.numbers

# Generated by make tiles (served from R2 in production)
web/public/data/
