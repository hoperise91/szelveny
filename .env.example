# Copy to .env and adjust. Used by docker-compose and the Makefile.
POSTGRES_DB=borna
POSTGRES_USER=borna
POSTGRES_PASSWORD=borna
POSTGRES_PORT=5432

# Cloudflare R2 (make deploy-data): an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=borna-data
R2_RAW_BUCKET=borna-raw   # private: saved copies of slow-changing sources (make snapshot-raw)
